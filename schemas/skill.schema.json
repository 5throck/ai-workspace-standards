{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://templates.circuit.stream/common/schemas/skill.schema.json",
  "title": "Skill Frontmatter Schema",
  "description": "Schema for skill SKILL.md file frontmatter enforcing required metadata fields and type classification",
  "type": "object",
  "required": ["name", "description", "version", "status", "owner", "metadata"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Machine-readable skill name identifier"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Human-readable description of the skill's purpose, min 10 characters"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Semantic version (MAJOR.MINOR.PATCH)"
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of last review (YYYY-MM-DD)"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "archived"],
      "description": "Current lifecycle status of the skill"
    },
    "scope": {
      "type": "string",
      "default": "common",
      "description": "Scope of the skill (e.g., common, platform-specific)"
    },
    "l2_propagate": {
      "type": "boolean",
      "description": "Whether the skill should propagate to L2 projects"
    },
    "owner": {
      "type": "string",
      "description": "Agent or team that owns this skill"
    },
    "prerequisites": {
      "type": "string",
      "description": "Prerequisites for using this skill"
    },
    "metadata": {
      "type": "object",
      "description": "Skill classification metadata",
      "required": ["type", "triggers"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["process", "security", "quality", "lifecycle"],
          "description": "Skill type classification"
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Trigger phrases or command names that activate this skill"
        }
      }
    }
  },
  "additionalProperties": true
}
