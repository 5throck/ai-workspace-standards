{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://templates.circuit.stream/common/schemas/agent.schema.json",
  "title": "Agent Frontmatter Schema",
  "description": "Schema for agent .md file frontmatter enforcing required metadata fields and lifecycle tracking",
  "type": "object",
  "required": ["name", "role", "status", "tier", "version", "last_reviewed", "description", "lifecycle"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable agent name"
    },
    "role": {
      "type": "string",
      "description": "Agent role identifier (e.g., specialist, generalist)"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "archived"],
      "description": "Current lifecycle status of the agent"
    },
    "tier": {
      "type": "object",
      "description": "Platform-specific tier assignments",
      "required": ["claude", "gemini", "antigravity", "gemini-cli"],
      "properties": {
        "claude": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Tier assignment for Claude platform"
        },
        "gemini": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Tier assignment for Gemini platform"
        },
        "antigravity": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Tier assignment for Antigravity platform"
        },
        "gemini-cli": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Tier assignment for Gemini CLI platform"
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "string",
      "default": "inherit",
      "description": "Model override (defaults to inherit)"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Semantic version (MAJOR.MINOR.PATCH)"
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of last review (YYYY-MM-DD)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Human-readable description of the agent's purpose, min 10 characters"
    },
    "lifecycle": {
      "type": "object",
      "description": "Lifecycle tracking metadata",
      "required": ["phase", "created", "last_updated"],
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["production", "development", "retired"],
          "description": "Current lifecycle phase"
        },
        "created": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date the agent was created (YYYY-MM-DD)"
        },
        "last_updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date of last update (YYYY-MM-DD)"
        },
        "governance": {
          "type": "string",
          "description": "Path to governance documentation"
        }
      }
    }
  },
  "additionalProperties": true
}
