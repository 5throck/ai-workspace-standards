{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://templates.circuit.stream/common/variant.schema.json",
  "title": "Variant JSON Schema",
  "description": "Schema for variant.json files enforcing lifecycle management requirements",
  "type": "object",
  "required": ["name", "description", "status", "version", "lifecycle"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^co-[a-z]+$",
      "description": "Variant identifier following naming convention (e.g., co-develop, co-security)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Human-readable description of the variant's purpose and scope"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "beta", "stable", "deprecated"],
      "description": "Current lifecycle stage"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Semantic version (MAJOR.MINOR.PATCH)"
    },
    "lifecycle": {
      "type": "object",
      "description": "Lifecycle tracking metadata",
      "required": ["statusSince", "lastTransition"],
      "properties": {
        "statusSince": {
          "type": "string",
          "format": "date",
          "description": "Date when current status was entered (YYYY-MM-DD)"
        },
        "lastTransition": {
          "type": "string",
          "description": "Human-readable description of last status change (e.g., 'beta → stable on 2026-05-28')"
        },
        "betaEngagements": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of successful engagements during beta phase"
        },
        "betaPromotedOn": {
          "type": "string",
          "format": "date",
          "description": "Date promoted to beta (null if not yet beta)"
        },
        "stablePromotedOn": {
          "type": "string",
          "format": "date",
          "description": "Date promoted to stable (null if not yet stable)"
        },
        "deprecatedOn": {
          "type": "string",
          "format": "date",
          "description": "Date variant was deprecated (null if not deprecated)"
        },
        "archiveOn": {
          "type": "string",
          "format": "date",
          "description": "Scheduled archive date (null if not scheduled)"
        }
      }
    },
    "variant_type": {
      "type": "string",
      "description": "Variant classification (e.g., consulting, collaboration, development)"
    },
    "inherits_common": {
      "type": "string",
      "description": "Path to common template this variant inherits from (e.g., templates/common)"
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 datetime when the variant was created"
    },
    "agents": {
      "type": "array",
      "description": "List of variant-specific agents",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "description": "Agent identifier" },
          "file": { "type": "string", "description": "Relative path to agent file (e.g., agents/foo.md)" },
          "role": { "type": "string", "description": "Optional one-line role description for the agent within this variant" }
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "List of variant-specific skills",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "description": "Skill identifier" },
          "version": { "type": "string", "description": "Skill version" },
          "file": { "type": "string", "description": "Relative path to SKILL.md (e.g., skills/foo/SKILL.md)" }
        }
      }
    },
    "displayName": {
      "type": "string",
      "description": "Human-readable variant name for display (e.g., 'Co Export', 'Co-News')"
    },
    "agent_overrides": {
      "type": "object",
      "description": "Per-agent configuration overrides for this variant",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "description": "Override type (e.g., 'additive', 'replacing')" },
          "reason": { "type": "string", "description": "Human-readable justification for the override" },
          "since": { "type": "string", "description": "Date or version when the override was introduced" },
          "reviewed_by": { "type": "string", "description": "Agent or role that reviewed/approved the override" },
          "overrides": { "type": "array", "items": { "type": "string" }, "description": "List of override categories (e.g., 'agent-roster', 'governance-workflow', 'dispatch-protocol')" }
        }
      }
    },
    "betaLifecycleSummary": {
      "type": "object",
      "description": "Beta variant lifecycle tracking and promotion eligibility",
      "properties": {
        "betaEngagements": { "type": "integer", "minimum": 0, "description": "Count of successful engagements during beta phase" },
        "betaBugs": { "type": "integer", "minimum": 0, "description": "Count of bugs reported during beta phase" },
        "betaAgeInMonths": { "type": "integer", "minimum": 0, "description": "Age of the variant in months since beta promotion" },
        "promotionEligible": { "type": "boolean", "description": "Whether the variant currently meets promotion criteria" },
        "missingCriteria": { "type": "array", "items": { "type": "string" }, "description": "List of unmet promotion criteria" },
        "lastSynced": { "type": "string", "description": "ISO 8601 datetime of last lifecycle summary sync" }
      }
    },
    "phaseAComplete": {
      "type": "boolean",
      "description": "Whether Phase A (prototype) is complete for this variant"
    },
    "promotionChecklist": {
      "type": "string",
      "description": "Path to the promotion checklist file (e.g., 'PROMOTION_CHECKLIST.md')"
    },
    "engagement_methodology": {
      "type": "string",
      "description": "Human-readable description of the variant's engagement methodology and phase structure"
    },
    "deliverable_template": {
      "type": "string",
      "description": "Human-readable description of standard deliverable templates per phase"
    },
    "stablePromotionSummary": {
      "type": "object",
      "description": "Stable promotion tracking metadata",
      "properties": {
        "promotedOn": { "type": "string", "description": "Date the variant was promoted to stable" },
        "previousStatus": { "type": "string", "description": "Status before promotion (e.g., 'beta')" },
        "promotionReason": { "type": "string", "description": "Human-readable justification for promotion" }
      }
    },
    "theme_manifest": {
      "type": "object",
      "description": "Variant-specific theme manifest (e.g., for co-deck HTML themes)",
      "properties": {
        "themes_dir": { "type": "string" },
        "base_css": { "type": "string" },
        "styles_dir": { "type": "string" },
        "overrides_dir": { "type": "string" },
        "shared_layout_base": { "type": "string" },
        "available": { "type": "array", "items": { "type": "string" }, "description": "List of available theme names" },
        "default": { "type": "string", "description": "Default theme name" },
        "notes": { "type": "string", "description": "Free-text notes on theme configuration" }
      }
    },
    "handbook_pipeline": {
      "type": "object",
      "description": "Independent handbook production pipeline manifest (e.g., for co-deck H-Stage)",
      "properties": {
        "description": { "type": "string" },
        "variant_agents_dir": { "type": "string" },
        "agents": { "type": "array", "items": { "type": "string" }, "description": "Agent names participating in the handbook pipeline" },
        "entry_skill": { "type": "string", "description": "Skill that triggers the handbook pipeline" },
        "notes": { "type": "string" }
      }
    },
    "trust_score_thresholds": {
      "type": "object",
      "description": "Trust score thresholds for quality gates (e.g., for co-deck source verification)",
      "properties": {
        "pass": { "type": "number", "minimum": 0, "maximum": 1, "description": "Minimum trust score to pass (e.g., 0.9)" },
        "warn": { "type": "number", "minimum": 0, "maximum": 1, "description": "Trust score threshold for warning (e.g., 0.7)" },
        "escalate": { "type": "number", "minimum": 0, "maximum": 1, "description": "Trust score threshold for escalation (e.g., 0.7)" }
      }
    },
    "lecture_profile": {
      "type": "object",
      "description": "Lecture profile configuration for presentation variants",
      "properties": {
        "template_path": { "type": "string", "description": "Path to master lecture profile template" },
        "project_path": { "type": "string", "description": "Path pattern for project-specific lecture profile" },
        "required_fields": { "type": "array", "items": { "type": "string" }, "description": "Required fields in the lecture profile" },
        "notes": { "type": "string" }
      }
    },
    "agent_manifest": {
      "type": "object",
      "description": "Agent orchestration metadata",
      "properties": {
        "variant_agents_dir": { "type": "string", "description": "Directory containing variant agent files" },
        "pipeline_order": { "type": "array", "items": { "type": "string" }, "description": "Ordered agent names for sequential pipeline phases" },
        "optional": { "type": "array", "items": { "type": "string" }, "description": "Agent names that are optional/situational" },
        "skippable": { "type": "array", "items": { "type": "string" }, "description": "Agent names that can be skipped (run but failure is non-blocking)" },
        "retry_policy": {
          "type": "object",
          "description": "Per-agent retry policies for transient failures",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "on_fail": { "type": "string", "description": "Agent to fall back to on failure" },
              "max_retries": { "type": "integer", "minimum": 1, "description": "Maximum retry attempts before escalation" },
              "failure_condition": { "type": "string", "description": "Condition that triggers retry (e.g., 'trust_score < threshold')" }
            }
          }
        },
        "notes": { "type": "string", "description": "Free-text notes on agent dispatch strategy" }
      }
    },
    "skill_manifest": {
      "type": "object",
      "description": "Skill orchestration metadata",
      "properties": {
        "variant_specific": {
          "type": "array",
          "description": "Variant-specific skill entries with usage metadata",
          "items": {
            "type": "object",
            "required": ["name", "used_by_agents", "phases"],
            "properties": {
              "name": { "type": "string" },
              "layer": { "type": "string" },
              "used_by_agents": { "type": "array", "items": { "type": "string" } },
              "phases": { "type": "array", "items": { "type": "integer" } },
              "platform_parity": { "type": "string" }
            }
          }
        }
      }
    },
    "script_manifest": {
      "type": "object",
      "description": "Script inventory metadata",
      "properties": {
        "variant_scripts_dir": { "type": "string", "description": "Directory containing variant-specific scripts" },
        "local": {
          "type": "array",
          "description": "Locally defined scripts",
          "items": {
            "type": "object",
            "required": ["name", "path"],
              "properties": {
                "name": { "type": "string" },
                "path": { "type": "string" },
                "status": { "type": "string", "description": "Script status (e.g., 'active', 'deprecated')" }
              }
          }
        },
        "external": {
          "type": "array",
          "description": "External script references",
          "items": { "type": "object" }
        }
      }
    },
    "country_config": {
      "type": "object",
      "description": "Country/jurisdiction profile configuration",
      "properties": {
        "profiles_dir": {
          "type": "string",
          "description": "Directory containing country profile markdown files (e.g., 'docs/countries')"
        },
        "supported": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{2,4}$" },
          "description": "List of supported ISO 3166-1 alpha-2 codes or well-known region codes (EU, ASEAN)"
        },
        "default": {
          "type": ["string", "null"],
          "description": "Default country code (null for region-neutral, which is the required default state)"
        }
      },
      "required": ["profiles_dir", "supported"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "beta" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "lifecycle": {
            "properties": {
              "betaEngagements": { "type": "integer" }
            },
            "required": ["betaEngagements"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "stable" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "lifecycle": {
            "properties": {
              "stablePromotedOn": { "type": "string" }
            },
            "required": ["stablePromotedOn"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "deprecated" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "lifecycle": {
            "properties": {
              "deprecatedOn": { "type": "string" }
            },
            "required": ["deprecatedOn"]
          }
        }
      }
    }
  ]
}
