{
    "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
    "root": true,
    "files": {
        "includes": ["scripts/**", "templates/common/scripts/handbook/**"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 2,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "assist": {
        "enabled": false
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "none",
            "style": {
                "useNodejsImportProtocol": "error"
            },
            "suspicious": {
                "noAssignInExpressions": "error",
                "noImplicitAnyLet": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "scripts/hooks/_*.ts",
                "scripts/experiments/**",
                "**/_office/**",
                "**/temp/**",
                "scripts/README.md",
                "scripts/SCRIPTS.md",
                "scripts/propagation-map.json",
                "scripts/helpers/typecheck-baseline.json"
            ],
            "linter": {
                "enabled": false
            },
            "formatter": {
                "enabled": false
            }
        }
    ]
}
