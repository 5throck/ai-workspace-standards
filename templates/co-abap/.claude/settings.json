{
  "mcpServers": {
    "abap": {
      "command": "bun",
      "args": [
        "scripts/sap-mcp-proxy.ts",
        "--",
        "--mode",
        "hyperfocused"
      ]
    },
    "abap-docs": {
      "type": "http",
      "url": "https://mcp-abap.marianzeis.de/mcp"
    },
    "sap-docs": {
      "type": "http",
      "url": "https://mcp-sap-docs.marianzeis.de/mcp"
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/post-write-lifecycle-check.ts",
            "timeout": 60,
            "async": true,
            "asyncRewake": true,
            "statusMessage": "Running post-edit lifecycle check..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" post-edit",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Bash|mcp__graft__|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" tool-savings",
            "timeout": 8000
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/sync-md.ts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .githooks",
            "async": true,
            "statusMessage": "Configuring git hooks..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" session-start",
            "timeout": 8000
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/pm-role-bootstrap.ts",
            "timeout": 10,
            "statusMessage": "Loading PM bootstrap..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/gateguard-fact-force.ts --mode ask",
            "timeout": 30,
            "statusMessage": "GateGuard: checking first-edit importers..."
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/post-write-lifecycle-check.ts",
            "timeout": 60,
            "async": true,
            "asyncRewake": true,
            "statusMessage": "Running teammate idle lifecycle check..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/audit.ts",
            "timeout": 120,
            "async": true,
            "statusMessage": "Running QA audit on task completion..."
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .githooks",
            "async": true,
            "statusMessage": "Configuring git hooks in new worktree..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" prompt",
            "timeout": 15000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" stop",
            "timeout": 8000
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(bun scripts/audit.ts *)",
      "Bash(bun scripts/lifecycle-sync-audit.ts *)",
      "Bash(bun run agent:verify *)",
      "Bash(curl -sI *)",
      "Bash(bun scripts/validate-templates.ts *)",
      "WebSearch(*)",
      "WebFetch(*)",
      "Bash(graft:*)",
      "Bash(npx graft:*)",
      "Bash(graft-dev:*)",
      "Bash(node dist/cli.js:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(*--no-verify*)",
      "Bash(rm -rf *)",
      "Bash(./vsp*)",
      "Bash(*/vsp)",
      "Bash(*/vsp *)",
      "Bash(bun *sap-approve*)",
      "Bash(node *sap-approve*)",
      "Bash(*grantApproval*)",
      "Bash(*consumeProxyApproval*)",
      "Bash(bun -e*)",
      "Bash(bun --eval*)",
      "Bash(node -e*)",
      "Bash(node --eval*)",
      "Bash(script *)",
      "Bash(git stash*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(rm *vsp*)",
      "Bash(mv *vsp*)",
      "Bash(cp *vsp*)",
      "Bash(bun *sap-integrity*)",
      "Bash(node *sap-integrity*)",
      "Bash(*sap-mcp-proxy*)",
      "Bash(python -c*)",
      "Bash(python3 -c*)",
      "Bash(perl -e*)",
      "Bash(expect*)",
      "Bash(unbuffer*)",
      "Bash(socat*)",
      "Bash(deno eval*)",
      "Bash(*approval.key*)",
      "Bash(*.config/co-abap*)",
      "Bash(cat *.env*)",
      "Bash(less *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Edit(.env*)",
      "Write(.env*)",
      "MultiEdit(.env*)",
      "Read(.env*)",
      "Edit(vsp)",
      "Write(vsp)",
      "MultiEdit(vsp)",
      "Edit(.mcp.json)",
      "Write(.mcp.json)",
      "MultiEdit(.mcp.json)",
      "Edit(.codex/config.toml)",
      "Write(.codex/config.toml)",
      "MultiEdit(.codex/config.toml)",
      "Edit(.gemini/settings.json)",
      "Write(.gemini/settings.json)",
      "MultiEdit(.gemini/settings.json)",
      "Edit(.agents/mcp.json)",
      "Write(.agents/mcp.json)",
      "MultiEdit(.agents/mcp.json)",
      "Edit(config/sap-action-policy.json)",
      "Write(config/sap-action-policy.json)",
      "MultiEdit(config/sap-action-policy.json)",
      "Edit(config/platforms/**)",
      "Write(config/platforms/**)",
      "MultiEdit(config/platforms/**)",
      "Edit(scripts/lib/sap-action-lib.ts)",
      "Write(scripts/lib/sap-action-lib.ts)",
      "MultiEdit(scripts/lib/sap-action-lib.ts)",
      "Edit(scripts/sap-mcp-proxy.ts)",
      "Write(scripts/sap-mcp-proxy.ts)",
      "MultiEdit(scripts/sap-mcp-proxy.ts)",
      "Edit(scripts/sap-approve.ts)",
      "Write(scripts/sap-approve.ts)",
      "MultiEdit(scripts/sap-approve.ts)",
      "Edit(scripts/sap-integrity.ts)",
      "Write(scripts/sap-integrity.ts)",
      "MultiEdit(scripts/sap-integrity.ts)",
      "Edit(scripts/hooks/sap-action-gate.ts)",
      "Write(scripts/hooks/sap-action-gate.ts)",
      "MultiEdit(scripts/hooks/sap-action-gate.ts)",
      "Edit(scripts/hooks/sap-action-audit.ts)",
      "Write(scripts/hooks/sap-action-audit.ts)",
      "MultiEdit(scripts/hooks/sap-action-audit.ts)",
      "Edit(scripts/dispatch-parallel.ts)",
      "Write(scripts/dispatch-parallel.ts)",
      "MultiEdit(scripts/dispatch-parallel.ts)",
      "Edit(.codex/rules/**)",
      "Write(.codex/rules/**)",
      "MultiEdit(.codex/rules/**)",
      "Edit(.geminiignore)",
      "Write(.geminiignore)",
      "MultiEdit(.geminiignore)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "MultiEdit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "MultiEdit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "MultiEdit(.claude/hooks/**)",
      "Edit(bunfig.toml)",
      "Write(bunfig.toml)",
      "MultiEdit(bunfig.toml)",
      "Edit(package.json)",
      "Write(package.json)",
      "MultiEdit(package.json)",
      "Edit(memory/audit/**)",
      "Write(memory/audit/**)",
      "MultiEdit(memory/audit/**)",
      "Edit(~/.config/co-abap/**)",
      "Write(~/.config/co-abap/**)",
      "MultiEdit(~/.config/co-abap/**)",
      "Read(~/.config/co-abap/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "auto",
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-statusline.cjs\""
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-statusline.cjs\""
  },
  "footerLinksRegexes": [
    "graft/[\\w./-]+\\.md"
  ]
}
