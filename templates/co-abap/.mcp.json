{
  "mcpServers": {
    "abap": {
      "command": "bun",
      "args": [
        "scripts/sap-mcp-proxy.ts",
        "--",
        "--mode",
        "hyperfocused"
      ]
    },
    "abap-docs": {
      "type": "http",
      "url": "https://mcp-abap.marianzeis.de/mcp"
    },
    "sap-docs": {
      "type": "http",
      "url": "https://mcp-sap-docs.marianzeis.de/mcp"
    },
    "graft": {
      "command": "graft",
      "args": [
        "mcp"
      ]
    }
  }
}
