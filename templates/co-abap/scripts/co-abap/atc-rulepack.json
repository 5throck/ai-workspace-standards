        { "id": "atc-p1-findings", "tool": "RunATCCheck", "atc_variant": "default-p1-filter", "severity_gate": "blocker", "owner": "devops-admin", "source": "clean-abap-checklist.md section 12: Transport release requires zero P1 findings" },
        { "id": "package-consistency", "tool": "RunATCCheck", "atc_variant": "package-interface", "severity_gate": "should", "owner": "devops-admin", "source": "clean-abap-checklist.md section 12: Package consistency" },
