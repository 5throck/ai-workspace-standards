  "platforms": {
    "claude": {
      "files": [
        ".claude/settings.json"
      ],
      "manual": {}
    },
    "gemini": {
      "files": [
        ".gemini/settings.json",
        ".gemini/settings.json.sample",
        ".geminiignore"
      ],
      "manual": {
        "grant-approval": "Inline-code strings cannot be matched by Gemini prefix rules; covered by blocking `bun -e`/`node -e` (inline-eval).",
        "consume-approval": "Same as grant-approval.",
        "path:*": "Gemini CLI cannot scope write_file/replace by path (tools.exclude is per tool). Reads of .env*/vsp are hidden through .geminiignore; writes are NOT blocked (this includes scripts/sap-integrity.ts, scripts/hooks/sap-action-*.ts, scripts/dispatch-parallel.ts, .geminiignore itself and ~/.config/co-abap/**). Residual risk, see SECURITY.md. Also unprotected here: .claude/settings*.json, .claude/hooks/**, bunfig.toml, package.json.",
        "key-access": "Not expressible as a prefix rule; reading approval.key or ~/.config/co-abap through the shell cannot be blocked here. Residual risk; full closure needs a separate OS user or OS keychain (SECURITY.md)."
      }
    },
    "codex": {
      "files": [
        ".codex/rules/default.rules",
        ".codex/config.toml"
      ],
      "manual": {
        "grant-approval": "Execpolicy matches argv prefixes, not substrings; covered by forbidding `bun -e`/`node -e` (inline-eval).",
        "consume-approval": "Same as grant-approval.",
        "path:*": "Codex has no per-path deny. The workspace-write sandbox (sandbox_mode) limits writes to the workspace; paths inside the workspace stay writable (this includes scripts/sap-integrity.ts, scripts/hooks/sap-action-*.ts, scripts/dispatch-parallel.ts and .codex/rules/**; ~/.config/co-abap/** is outside the workspace sandbox). Residual risk, see SECURITY.md. Also unprotected here: .claude/settings*.json, .claude/hooks/**, bunfig.toml, package.json.",
        "key-access": "Not expressible as a prefix rule; reading approval.key or ~/.config/co-abap through the shell cannot be blocked here. Residual risk; full closure needs a separate OS user or OS keychain (SECURITY.md)."
      }
    },
    "antigravity": {
      "files": [
        "docs/platform-setup/antigravity.md",
        ".gemini/settings.json"
      ],
      "manual": {
        "cmd:*": "Antigravity IDE/CLI read no repo-level deny file. Set the terminal policy to Off/Request Review and add the commands to the IDE deny list by hand (docs/platform-setup/antigravity.md).",
        "path:*": "No per-path deny in Antigravity; reads/writes cannot be restricted. Residual risk, see SECURITY.md. Includes the new entries (sap-integrity, hooks, .claude/*, bunfig.toml, package.json).",
        "key-access": "Not expressible as a prefix rule; reading approval.key or ~/.config/co-abap through the shell cannot be blocked here. Residual risk; full closure needs a separate OS user or OS keychain (SECURITY.md)."
      }
    },
    "hermes": {
      "files": [
        "config/platforms/hermes-mcp.example.yaml",
        "docs/platform-setup/hermes.md"
      ],
      "manual": {
        "cmd:*": "Hermes has no user-configurable per-command deny list; use approvals.mode=manual (see yaml example) and run Hermes in a container/separate OS user (docs/platform-setup/hermes.md).",
        "path:*": "No per-path deny in Hermes. Residual risk, see SECURITY.md. Includes the new entries (sap-integrity, hooks, .claude/*, bunfig.toml, package.json).",
        "key-access": "Not expressible as a prefix rule; reading approval.key or ~/.config/co-abap through the shell cannot be blocked here. Residual risk; full closure needs a separate OS user or OS keychain (SECURITY.md)."
      }
    }
  }
