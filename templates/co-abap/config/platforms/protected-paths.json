{
  "$comment": "Single source of truth for the agent-shell protected set on all 8 platforms. Checked by `bun scripts/validate-abap-platform-parity.ts` (check id: deny-rules). Residual risk: a same-UID agent with an unrestricted shell can still read ~/.config/co-abap/approval.key; full closure needs a separate OS user (see SECURITY.md).",
  "version": 1,
  "commands": [
    {
      "id": "vsp-exec",
      "description": "Execute vsp directly (bypasses the proxy)",
      "claude": [
        "Bash(./vsp*)",
        "Bash(*/vsp)",
        "Bash(*/vsp *)"
      ],
      "gemini": [
        "./vsp",
        "vsp",
        "run_shell_command(./vsp)",
        "run_shell_command(vsp)"
      ],
      "codex": [
        [
          "./vsp"
        ],
        [
          "vsp"
        ]
      ]
    },
    {
      "id": "approve-cli",
      "description": "Run sap-approve (human-only)",
      "claude": [
        "Bash(bun *sap-approve*)",
        "Bash(node *sap-approve*)"
      ],
      "gemini": [
        "bun scripts/sap-approve.ts",
        "node scripts/sap-approve.ts",
        "run_shell_command(bun scripts/sap-approve.ts)",
        "run_shell_command(node scripts/sap-approve.ts)"
      ],
      "codex": [
        [
          "bun",
          "scripts/sap-approve.ts"
        ],
        [
          "bun",
          "./scripts/sap-approve.ts"
        ],
        [
          "node",
          "scripts/sap-approve.ts"
        ],
        [
          "node",
          "./scripts/sap-approve.ts"
        ]
      ]
    },
    {
      "id": "grant-approval",
      "description": "Call grantApproval from inline code",
      "claude": [
        "Bash(*grantApproval*)"
      ],
      "gemini": [],
      "codex": []
    },
    {
      "id": "consume-approval",
      "description": "Call consumeProxyApproval from inline code",
      "claude": [
        "Bash(*consumeProxyApproval*)"
      ],
      "gemini": [],
      "codex": []
    },
    {
      "id": "inline-eval",
      "description": "Inline code execution (bun -e / --eval, node -e)",
      "claude": [
