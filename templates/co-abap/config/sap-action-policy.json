  "r3Patterns": [
    "^Delete",
    "Delete$",
    "^Install",
    "Deploy",
    "^Drop",
    "^Insert",
    "^Modify",
    "^Import",
    "^UI5",
    "Publish",
    "Unpublish",
    "^Upload",
    "ServiceBinding"
  ],
  "defaultUnknown": "ask",
  "allowedPackages": [
    "Z*",
    "$TMP",
    "$ZADT_VSP",
    "$VSP_ADT"
  ],
  "runQuery": {
    "selectOnly": true
  },
  "approval": {
    "_doc": "Approvals live outside the workspace in ~/.config/co-abap/approvals/<repo-hash>/ (hardcoded, HMAC-signed by sap-approve.ts). Only ttlMinutes is read here.",
    "ttlMinutes": 15
  },
  "release": {
    "requireEvidence": true
  },
  "vspFeatures": {
    "_doc": "SAP_FEATURE_* keys that .env or the client env may turn on. Empty: every privileged vsp feature stays off. Changing this requires re-signing (bun scripts/sap-integrity.ts sign).",
    "allowOn": []
  },
  "hyperfocused": {
    "_doc": "vsp v2.60.0 SAP_MODE=hyperfocused: one tool `SAP` {action,target,params}. Sub-type is params.type, params.op or a single-word target. Unknown action/sub-type => ask. Data only; logic in scripts/lib/sap-action-lib.ts.",
    "actions": {
      "read": "R0",
      "search": "R0",
      "grep": "R0",
      "revisions": "R0",
      "info": "R0",
      "help": "R0",
      "lint": "R0",
      "query": {
        "class": "R0",
        "sql": true
      },
      "test": {
        "class": "R1",
        "subFrom": [
          "type",
          "target"
        ],
        "subDefault": "unit",
        "unknown": "ask",
        "sub": {
          "unit": {
            "class": "R1",
            "evidence": [
              "RunUnitTests"
            ],
            "evidenceIfParam": {
              "coverage": [
                "GetCodeCoverage"
              ],
              "with_coverage": [
                "GetCodeCoverage"
              ]
            }
          },
          "atc": {
            "class": "R1",
            "evidence": [
              "RunATCCheck"
            ]
          },
          "atc_customizing": "R0"
        }
      },
      "analyze": {
        "class": "R0",
        "subFrom": [
          "type"
        ],
        "unknown": "ask",
        "sub": {
          "abap_help": "R0",
          "analyze_call_graph": "R0",
          "analyze_deps": "R0",
          "application_log": "R0",
          "call_graph": "R0",
          "callees": "R0",
