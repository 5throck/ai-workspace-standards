          "documentation": "R0",
          "dump_impact": "R0",
          "effects": "R0",
          "explain_dump": "R0",
          "fm_test_data": "R0",
          "get_dump": "R0",
          "get_pretty_printer_settings": "R0",
          "get_trace": "R0",
          "graph_stats": "R0",
          "group_dumps": "R0",
          "health": "R0",
          "img_activity": "R0",
          "img_search": "R0",
          "impact": "R0",
          "inactive_objects": "R0",
          "job_list": "R0",
          "job_log": "R0",
          "list_dumps": "R0",
          "list_sql_traces": "R0",
          "list_traces": "R0",
          "loads": "R0",
          "object_structure": "R0",
          "parse_abap": "R0",
          "pretty_print": "R0",
          "references": "R0",
          "similar_dumps": "R0",
          "spool_list": "R0",
          "spool_read": "R0",
          "sql_trace_state": "R0",
          "tr_boundaries": "R0",
          "type_hierarchy": "R0",
          "usage_examples": "R0",
          "variants": "R0",
          "where_used_config": "R0",
          "syntax_check": {
            "class": "R1",
            "evidence": [
              "SyntaxCheck"
            ]
          },
          "trace_execution": "R1",
          "set_pretty_printer_settings": {
            "class": "R2",
            "write": false
          },
          "execute_abap": "R3",
          "cluster_read": "R3"
        }
      },
      "edit": {
        "class": "R2",
        "subFrom": [
          "target"
        ],
        "unknown": "default",
        "sub": {
          "compare_source": "R0",
          "activate": {
            "class": "R2",
            "write": false
          },
          "activate_multi": {
            "class": "R2",
            "write": false
          },
          "activate_package": {
            "class": "R2",
