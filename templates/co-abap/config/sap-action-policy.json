{
  "version": 1,
  "classes": {
    "R0": [
      "GetSource",
      "GetRevisionSource",
      "SearchObject",
      "GetTable",
      "GetTableContents",
      "GetCDSDependencies",
      "GetCDSImpactAnalysis",
      "GetCDSExposure",
      "GetODataMetadata",
      "GetFunctionGroup",
