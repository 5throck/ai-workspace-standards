    "urlTypes": {
      "oo/classes": "CLAS",
      "oo/interfaces": "INTF",
      "programs/programs": "PROG",
      "programs/includes": "INCL",
      "functions/groups": "FUGR",
      "ddic/ddl/sources": "DDLS",
