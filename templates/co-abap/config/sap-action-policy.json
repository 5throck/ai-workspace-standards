          }
        }
      },
      "create": "R2",
      "i18n": {
        "class": "R2",
        "subFrom": [
          "op"
        ],
        "unknown": "ask",
        "sub": {
          "compare_languages": "R0",
          "data_element_labels": "R0",
          "message_class_texts": "R0",
          "texts": "R0",
          "texts_get": "R0",
          "texts_set": "R2",
          "write_message_texts": "R2"
        }
      },
      "delete": "R3",
      "debug": "R3",
