# Secrets — never commit
.env

# Python
.venv/
__pycache__/
*.pyc
*.pyo
dist/
*.egg-info/

# Node.js
node_modules/
.next/
dist/
build/

# OS artifacts
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Local AI settings (personal overrides — never shared)
.claude/settings.local.json
.gemini/settings.local.json
.mcp.local.json

# Crypto / certificates — never commit private key material
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der
*.jks
*.keystore

# Temp / build artifacts
*.log
*.bak
*.tmp

# Scratch workspace — temp/ is throwaway (not committed)
scratch/temp/

# Databases
*.sqlite
*.db

# CodeGraph Index
.codegraph/

# OpenChrome MCP local cache
.openchrome/

# vsp MCP server binary (downloaded, not source)
/vsp
vsp.exe

# Prevent .cmd files (use .sh/.ts or .ps1 instead)
*.cmd
