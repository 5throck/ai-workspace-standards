#!/usr/bin/env bash
set -euo pipefail
# .githooks/post-checkout

PREV_COMMIT=$1
POST_COMMIT=$2
IS_BRANCH_CHECKOUT=$3

# Only trigger on branch checkouts
if [ "$IS_BRANCH_CHECKOUT" != "1" ]; then
    exit 0
fi

# Get the current branch name
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# ── Validate branch name before embedding in any prompt ───────────────────────
# Reject branch names containing characters that could corrupt shell strings
# or AI CLI prompts (quotes, newlines, semicolons, percent signs, etc.)
if ! echo "$BRANCH_NAME" | grep -qE '^[a-zA-Z0-9/_.-]+$'; then
    echo "⚠️  post-checkout: branch name '$BRANCH_NAME' contains unsafe characters."
    echo "   AI auto-orchestration skipped. Rename the branch to use only: a-z A-Z 0-9 / _ . -"
    exit 0
fi

# Auto-orchestration is opt-in (T-20260910-024): a hook that spawns AI sessions
# on every branch checkout is too aggressive as a default. Set AI_AUTOSTART=1 in
# your shell profile to enable automatic AI session launch on branch creation.
if [ "${AI_AUTOSTART:-0}" != "1" ]; then
  exit 0
fi

# Lock guard: prevent concurrent background AI sessions when the user checks out
# multiple branches in quick succession. The AI process only reads/analyzes and
# writes to the log file, so file conflicts are unlikely — the lock primarily
# prevents redundant parallel sessions.
#
# Stale-lock detection (T-20260910-024): the lock is held by the *background
# session subshell*, not by this hook — the hook exits immediately after
# launching, so an EXIT trap here would release the lock before the AI session
# even starts. The lock file records the owning PID; a lock whose PID is no
# longer alive is stale and removed instead of blocking all future checkouts.
LOCK_FILE="$(git rev-parse --git-dir)/post-checkout-ai.lock"

if [ -f "$LOCK_FILE" ]; then
  LOCK_PID=$(cat "$LOCK_FILE" 2>/dev/null || true)
  if [ -n "$LOCK_PID" ] && kill -0 "$LOCK_PID" 2>/dev/null; then
    echo "[post-checkout] AI session already running (pid $LOCK_PID), skipping."
    exit 0
  fi
  echo "[post-checkout] Removing stale AI session lock (pid ${LOCK_PID:-unknown} is gone)."
  rm -f "$LOCK_FILE"
fi

# Trigger only for new feature/design/fix branches
if [[ "$BRANCH_NAME" == "feat/"* || "$BRANCH_NAME" == "feature/"* || "$BRANCH_NAME" == "design/"* || "$BRANCH_NAME" == "fix/"* ]]; then
    echo "=========================================================="
    echo "🤖 AIG Auto-Orchestration Triggered!"
    echo "Branch: $BRANCH_NAME"
    echo "Starting PM Agent Kickoff in the background..."
    echo "=========================================================="

    # Build prompt from safe, validated branch name
    PROMPT="A new branch '${BRANCH_NAME}' was created. Please lead a PM kickoff meeting with all agents to derive improvement plans and create an implementation plan for this branch. Reference Phase 0/1."

    # Log location for the background process output — inside .git/, never committed.
    LOG_FILE="$(git rev-parse --git-dir)/post-checkout-ai.log"

    # Platform-neutral AI CLI detection — uses whichever CLI is installed:
    # Claude Code, Gemini CLI, Antigravity CLI, or Codex.
    AI_CLI=""
    AI_ARGS=()
    if command -v claude &> /dev/null; then
        AI_CLI="claude"; AI_ARGS=(-p "$PROMPT")
    elif command -v gemini &> /dev/null; then
        AI_CLI="gemini"; AI_ARGS=(-p "$PROMPT")
    elif command -v antigravity &> /dev/null; then
        AI_CLI="antigravity"; AI_ARGS=(pm --prompt "$PROMPT")
    elif command -v codex &> /dev/null; then
        AI_CLI="codex"; AI_ARGS=(--prompt "$PROMPT")
    else
        echo "⚠️ No supported AI CLI found (claude, gemini, antigravity, codex)."
        echo "   Please run the kickoff manually:"
        echo "   'Let's start the PM agent kickoff meeting for this project.'"
    fi

    if [ -n "$AI_CLI" ]; then
        # The subshell owns the lock for the AI session's full lifetime: it is
        # created here and removed when the AI process exits — not when this
        # hook returns (which happens immediately after backgrounding).
        # BASHPID, not $$ — in a subshell $$ still reports the parent hook's
        # PID, which has already exited, so the stale-lock guard above would
        # immediately judge the lock stale and let a concurrent checkout
        # through.
        (
            echo "$BASHPID" > "$LOCK_FILE"
            "$AI_CLI" "${AI_ARGS[@]}" > "$LOG_FILE" 2>&1
            rm -f "$LOCK_FILE"
        ) &
        echo "✅ $AI_CLI launched in the background."
        echo "   Output log: $LOG_FILE"
    fi
    echo "=========================================================="
fi

exit 0
