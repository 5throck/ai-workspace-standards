{
  "primitive": {
    "color": {
      "blue": { "500": "#0066cc", "600": "#0052a3", "300": "#4d9fff", "700": "#003e8a" },
      "gray": { "500": "#6c757d", "400": "#9ca3af", "600": "#495057" },
      "green": { "500": "#28a745", "300": "#34d399", "700": "#146829" },
      "amber": { "500": "#ffc107", "300": "#fbbf24", "700": "#664d03" },
      "red": { "500": "#dc3545", "300": "#f87171", "700": "#a71d2a" },
      "neutral": { "0": "#ffffff", "50": "#f9fafb", "900": "#111827", "950": "#000000" },
      "ink": { "900": "#1a1a1a" }
    },
    "font": {
      "sans": "Inter, system-ui, -apple-system, sans-serif",
      "mono": "Fira Code, monospace"
    },
    "font-size": { "sm": "0.875rem", "base": "1rem", "lg": "1.25rem", "xl": "1.5rem" },
    "space": { "xs": "0.25rem", "sm": "0.5rem", "md": "1rem", "lg": "1.5rem", "xl": "2rem" },
    "radius": { "sm": "4px", "md": "8px", "lg": "16px" },
    "elevation": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.05)",
      "md": "0 4px 6px rgba(0, 0, 0, 0.1)",
      "lg": "0 10px 15px rgba(0, 0, 0, 0.1)"
    },
    "duration": { "fast": "150ms", "normal": "250ms", "slow": "400ms" }
  },
  "semantic": {
    "color": {
      "primary": "var(--color-blue-500)",
      "secondary": "var(--color-gray-500)",
      "success": "var(--color-green-500)",
      "warning": "var(--color-amber-500)",
      "danger": "var(--color-red-500)",
      "background": "var(--color-neutral-0)",
      "text": "var(--color-ink-900)"
    },
    "typography": {
      "font-family": {
        "sans": "var(--font-sans)",
        "mono": "var(--font-mono)"
      },
      "font-size": {
        "sm": "var(--font-size-sm)",
        "base": "var(--font-size-base)",
        "lg": "var(--font-size-lg)",
        "xl": "var(--font-size-xl)"
      }
    },
    "spacing": {
      "xs": "var(--space-xs)",
      "sm": "var(--space-sm)",
      "md": "var(--space-md)",
      "lg": "var(--space-lg)",
      "xl": "var(--space-xl)"
    },
    "border-radius": {
      "sm": "var(--radius-sm)",
      "md": "var(--radius-md)",
      "lg": "var(--radius-lg)"
    },
    "shadow": {
      "sm": "var(--elevation-sm)",
      "md": "var(--elevation-md)",
      "lg": "var(--elevation-lg)"
    },
    "motion": {
      "duration-fast": "var(--duration-fast)",
      "duration-normal": "var(--duration-normal)",
      "duration-slow": "var(--duration-slow)"
    },
    "target": {
      "size": "2.75rem"
    },
    "focus": {
      "ring": "2px solid var(--color-primary)",
      "ring-offset": "2px"
    }
  },
  "themes": {
    "dark": {
      "color": {
        "primary": "var(--color-blue-300)",
        "secondary": "var(--color-gray-400)",
        "success": "var(--color-green-300)",
        "warning": "var(--color-amber-300)",
        "danger": "var(--color-red-300)",
        "background": "var(--color-neutral-900)",
        "text": "var(--color-neutral-50)"
      },
      "shadow": {
        "sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
        "md": "0 4px 6px rgba(0, 0, 0, 0.4)",
        "lg": "0 10px 15px rgba(0, 0, 0, 0.5)"
      }
    },
    "high-contrast": {
      "color": {
        "primary": "var(--color-blue-700)",
        "secondary": "var(--color-gray-600)",
        "success": "var(--color-green-700)",
        "warning": "var(--color-amber-700)",
        "danger": "var(--color-red-700)",
        "background": "var(--color-neutral-0)",
        "text": "var(--color-neutral-950)"
      }
    }
  }
}
