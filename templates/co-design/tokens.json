{
  "primitive": {
    "color": {
      "blue": { "500": "#0066cc", "600": "#0052a3", "300": "#4d9fff", "700": "#003e8a" },
      "gray": { "500": "#6c757d", "400": "#9ca3af", "600": "#495057" },
      "green": { "50": "#e8f7ee", "500": "#28a745", "300": "#34d399", "700": "#146829", "900": "#0b3d21" },
      "amber": { "50": "#fff8e1", "500": "#ffc107", "300": "#fbbf24", "700": "#664d03", "900": "#4d3a02" },
      "red": { "50": "#fdeceb", "500": "#dc3545", "300": "#f87171", "700": "#a71d2a", "900": "#5c1119" },
      "neutral": { "0": "#ffffff", "50": "#f9fafb", "900": "#111827", "950": "#000000" },
      "ink": { "900": "#1a1a1a" }
    },
    "font": {
      "sans": "Inter, system-ui, -apple-system, sans-serif",
      "mono": "Fira Code, monospace"
    },
    "text-size": { "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.25rem", "xl": "1.5rem" },
    "weight": { "regular": "400", "bold": "700", "heading": "800" },
    "space": { "xs": "0.25rem", "sm": "0.5rem", "md": "1rem", "lg": "1.5rem", "xl": "2rem" },
    "radius": { "sm": "4px", "md": "8px", "lg": "16px" },
    "elevation": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.05)",
      "md": "0 4px 6px rgba(0, 0, 0, 0.1)",
      "lg": "0 10px 15px rgba(0, 0, 0, 0.1)"
    },
    "duration": { "fast": "150ms", "normal": "250ms", "slow": "400ms" }
  },
  "semantic": {
    "color": {
      "primary": "var(--color-blue-500)",
      "secondary": "var(--color-gray-500)",
      "success": "var(--color-green-500)",
      "warning": "var(--color-amber-500)",
      "danger": "var(--color-red-500)",
      "success-bg": "var(--color-green-50)",
      "success-fg": "var(--color-green-700)",
      "success-border": "var(--color-green-300)",
      "warning-bg": "var(--color-amber-50)",
      "warning-fg": "var(--color-amber-700)",
      "warning-border": "var(--color-amber-300)",
      "danger-bg": "var(--color-red-50)",
      "danger-fg": "var(--color-red-700)",
      "danger-border": "var(--color-red-300)",
      "background": "var(--color-neutral-0)",
      "text": "var(--color-ink-900)"
    },
    "typography": {
      "font-family": {
        "sans": "var(--font-sans)",
        "mono": "var(--font-mono)"
      },
      "font-size": {
        "xs": "var(--text-size-xs)",
        "sm": "var(--text-size-sm)",
        "base": "var(--text-size-base)",
        "lg": "var(--text-size-lg)",
        "xl": "var(--text-size-xl)"
      },
      "font-weight": {
        "regular": "var(--weight-regular)",
        "bold": "var(--weight-bold)",
        "heading": "var(--weight-heading)"
      }
    },
    "spacing": {
      "xs": "var(--space-xs)",
      "sm": "var(--space-sm)",
      "md": "var(--space-md)",
      "lg": "var(--space-lg)",
      "xl": "var(--space-xl)"
    },
    "border-radius": {
      "sm": "var(--radius-sm)",
      "md": "var(--radius-md)",
      "lg": "var(--radius-lg)"
    },
    "shadow": {
      "sm": "var(--elevation-sm)",
      "md": "var(--elevation-md)",
      "lg": "var(--elevation-lg)"
    },
    "motion": {
      "duration-fast": "var(--duration-fast)",
      "duration-normal": "var(--duration-normal)",
      "duration-slow": "var(--duration-slow)"
    },
    "target": {
      "size": "2.75rem"
    },
    "focus": {
      "ring": "2px solid var(--color-primary)",
      "ring-offset": "2px"
    }
  },
  "component": {
    "button": {
      "primary-bg": "var(--color-primary)",
      "primary-fg": "var(--color-background)",
      "ghost-fg": "var(--color-primary)",
      "ghost-border": "var(--color-primary)",
      "radius": "var(--border-radius-sm)",
      "padding-x": "var(--spacing-md)",
      "padding-y": "var(--spacing-sm)"
    },
    "card": {
      "bg": "var(--color-background)",
      "border": "var(--color-secondary)",
      "radius": "var(--border-radius-md)",
      "padding": "var(--spacing-md)",
      "shadow": "var(--shadow-sm)"
    },
    "input": {
      "bg": "var(--color-background)",
      "fg": "var(--color-text)",
      "border": "var(--color-secondary)",
      "border-focus": "var(--color-primary)",
      "radius": "var(--border-radius-sm)",
      "padding": "var(--spacing-sm)"
    },
    "field": {
      "gap": "var(--spacing-xs)",
      "label-weight": "var(--typography-font-weight-bold)"
    },
    "badge": {
      "success-bg": "var(--color-success-bg)",
      "success-fg": "var(--color-success-fg)",
      "warning-bg": "var(--color-warning-bg)",
      "warning-fg": "var(--color-warning-fg)",
      "danger-bg": "var(--color-danger-bg)",
      "danger-fg": "var(--color-danger-fg)",
      "radius": "var(--border-radius-sm)",
      "padding-y": "var(--spacing-xs)",
      "padding-x": "var(--spacing-sm)",
      "font-size": "var(--typography-font-size-sm)"
    },
    "table": {
      "border": "var(--color-secondary)",
      "padding": "var(--spacing-sm)"
    },
    "modal": {
      "bg": "var(--color-background)",
      "fg": "var(--color-text)",
      "radius": "var(--border-radius-md)",
      "padding": "var(--spacing-lg)",
      "shadow": "var(--shadow-lg)"
    },
    "tabs": {
      "fg": "var(--color-text)",
      "fg-selected": "var(--color-primary)",
      "underline": "var(--color-primary)",
      "border": "var(--color-secondary)",
      "panel-padding": "var(--spacing-md)",
      "panel-radius": "var(--border-radius-md)"
    },
    "pagestate": {
      "border": "var(--color-secondary)",
      "radius": "var(--border-radius-md)",
      "padding": "var(--spacing-md)",
      "error-bg": "var(--color-danger-bg)",
      "error-fg": "var(--color-danger-fg)",
      "error-border": "var(--color-danger-border)"
    },
    "toast": {
      "success-bg": "var(--color-success-bg)",
      "success-fg": "var(--color-success-fg)",
      "success-border": "var(--color-success-border)",
      "danger-bg": "var(--color-danger-bg)",
      "danger-fg": "var(--color-danger-fg)",
      "danger-border": "var(--color-danger-border)",
      "radius": "var(--border-radius-sm)",
      "padding-x": "var(--spacing-md)",
      "padding-y": "var(--spacing-xs)",
      "shadow": "var(--shadow-md)"
    }
  },
  "themes": {
    "dark": {
      "color": {
        "primary": "var(--color-blue-300)",
        "secondary": "var(--color-gray-400)",
        "success": "var(--color-green-300)",
        "warning": "var(--color-amber-300)",
        "danger": "var(--color-red-300)",
        "success-bg": "var(--color-green-900)",
        "success-fg": "var(--color-green-300)",
        "success-border": "var(--color-green-500)",
        "warning-bg": "var(--color-amber-900)",
        "warning-fg": "var(--color-amber-300)",
        "warning-border": "var(--color-amber-500)",
        "danger-bg": "var(--color-red-900)",
        "danger-fg": "var(--color-red-300)",
        "danger-border": "var(--color-red-500)",
        "background": "var(--color-neutral-900)",
        "text": "var(--color-neutral-50)"
      },
      "shadow": {
        "sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
        "md": "0 4px 6px rgba(0, 0, 0, 0.4)",
        "lg": "0 10px 15px rgba(0, 0, 0, 0.5)"
      }
    },
    "high-contrast": {
      "color": {
        "primary": "var(--color-blue-700)",
        "secondary": "var(--color-gray-600)",
        "success": "var(--color-green-700)",
        "warning": "var(--color-amber-700)",
        "danger": "var(--color-red-700)",
        "success-bg": "var(--color-green-50)",
        "success-fg": "var(--color-green-700)",
        "success-border": "var(--color-green-700)",
        "warning-bg": "var(--color-amber-50)",
        "warning-fg": "var(--color-amber-700)",
        "warning-border": "var(--color-amber-700)",
        "danger-bg": "var(--color-red-50)",
        "danger-fg": "var(--color-red-700)",
        "danger-border": "var(--color-red-700)",
        "background": "var(--color-neutral-0)",
        "text": "var(--color-neutral-950)"
      }
    }
  }
}
