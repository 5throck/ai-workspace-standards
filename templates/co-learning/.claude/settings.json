{
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(bun scripts/audit.ts *)",
      "Bash(bun scripts/lifecycle-sync-audit.ts *)",
      "Bash(bun run agent:verify *)",
      "Bash(curl -sI *)",
      "Bash(bun scripts/validate-templates.ts *)",
      "WebSearch(*)",
      "WebFetch(*)",
      "Bash(graft:*)",
      "Bash(npx graft:*)",
      "Bash(graft-dev:*)",
      "Bash(node dist/cli.js:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(*--no-verify*)",
      "Bash(rm -rf *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "auto",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .githooks",
            "async": true,
            "statusMessage": "Configuring git hooks..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" ]; then node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" session-start; fi",
            "timeout": 8000
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/pm-role-bootstrap.ts",
            "timeout": 10,
            "statusMessage": "Loading PM bootstrap..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/post-write-lifecycle-check.ts",
            "timeout": 60,
            "async": true,
            "asyncRewake": true,
            "statusMessage": "Running post-edit lifecycle check..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" ]; then node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" post-edit; fi",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Bash|mcp__graft__|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" ]; then node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" tool-savings; fi",
            "timeout": 8000
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/post-write-lifecycle-check.ts",
            "timeout": 60,
            "async": true,
            "asyncRewake": true,
            "statusMessage": "Running teammate idle lifecycle check..."
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .githooks",
            "async": true,
            "statusMessage": "Configuring git hooks in new worktree..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/audit.ts",
            "timeout": 120,
            "async": true,
            "statusMessage": "Running QA audit on task completion..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/gateguard-fact-force.ts --mode ask",
            "timeout": 30,
            "statusMessage": "GateGuard: checking first-edit importers..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" ]; then node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" prompt; fi",
            "timeout": 15000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" ]; then node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-hooks.cjs\" stop; fi",
            "timeout": 8000
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "if [ -f \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-statusline.cjs\" ]; then node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-statusline.cjs\"; fi"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "if [ -f \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-statusline.cjs\" ]; then node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-statusline.cjs\"; fi"
  },
  "footerLinksRegexes": [
    "graft/[\\w./-]+\\.md"
  ]
}
