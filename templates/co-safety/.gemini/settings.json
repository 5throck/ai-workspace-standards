{
  "_comment": "Safety OS project settings — variant-specific overrides vs L1 (templates/common). The former '#' header comment broke strict JSON parity validation (P-01 parses both platform settings with JSON.parse).",
  "mcpServers": {
    "kr_safety": {
      "command": "bun",
      "args": [
        "run",
        "--env-file",
        ".env",
        "./mcp/kr-safety-regs/index.ts"
      ]
    },
    "graft": {
      "command": "graft",
      "args": [
        "mcp"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "git config core.hooksPath .githooks",
        "statusMessage": "Configuring git hooks..."
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/pm-role-bootstrap.ts",
            "timeout": 8000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "write_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/gateguard-fact-force.ts --platform gemini",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/pm-dispatch-gate.ts",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/post-write-lifecycle-check.ts --platform gemini",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "terminal.executionPolicy": "Manual",
  "artifact.reviewPolicy": "Auto",
  "mcp.toolApproval": "Manual",
  "terminal.denyList": [
    "rm -rf",
    "rm -r /",
    "chmod -R 777",
    "git push --force",
    "git reset --hard",
    "reboot",
    "shutdown",
    "format",
    "fdisk",
    "mkfs",
    "bun -e",
    "bun --eval",
    "node -e",
    "node --eval",
    "run_shell_command(bun -e)",
    "run_shell_command(bun --eval)",
    "run_shell_command(node -e)",
    "run_shell_command(node --eval)",
    "python -c",
    "python3 -c",
    "perl -e",
    "deno eval",
    "run_shell_command(python -c)",
    "run_shell_command(python3 -c)",
    "run_shell_command(perl -e)",
    "run_shell_command(deno eval)",
    "expect",
    "unbuffer",
    "socat",
    "script",
    "run_shell_command(expect)",
    "run_shell_command(unbuffer)",
    "run_shell_command(socat)",
    "run_shell_command(script)",
    "git stash",
    "git checkout --",
    "git restore",
    "git clean",
    "run_shell_command(git stash)",
    "run_shell_command(git checkout --)",
    "run_shell_command(git restore)",
    "run_shell_command(git clean)",
    "cat .env",
    "less .env",
    "head .env",
    "tail .env",
    "run_shell_command(cat .env)",
    "run_shell_command(less .env)",
    "run_shell_command(head .env)",
    "run_shell_command(tail .env)"
  ]
}
