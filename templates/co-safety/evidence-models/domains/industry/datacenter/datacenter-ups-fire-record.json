{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "datacenter-ups-fire-record.json",
  "title": "Data Center UPS Battery Fire Safety Record",
  "description": "Evidence model for Data Center Lithium-ion UPS Battery Thermal Monitoring and Fire Suppression Inspection.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "record_id",
    "ups_room_id",
    "legal_basis",
    "audit_trail"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^DC-UPS-[0-9]{4}-[0-9]{4}$"
    },
    "ups_room_id": {
      "type": "string"
    },
    "max_battery_temp_celsius": {
      "type": "number"
    },
    "gas_suppression_ready": {
      "type": "boolean"
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "audit_trail": {
      "$ref": "../../../_shared/base/common.schema.json#/definitions/audit_trail"
    }
  }
}
