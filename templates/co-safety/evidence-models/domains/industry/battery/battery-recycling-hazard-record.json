{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "battery-recycling-hazard-record.json",
  "title": "Battery Recycling Chemical Hazard Record",
  "description": "Evidence model for Battery Recycling Toxic Chemical Extraction Hazard Inspection.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "record_id",
    "batch_id",
    "legal_basis",
    "audit_trail"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^BATT-RECYC-[0-9]{4}-[0-9]{4}$"
    },
    "batch_id": {
      "type": "string"
    },
    "leaching_solvents": {
      "type": "string"
    },
    "acid_containment_verified": {
      "type": "boolean"
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "audit_trail": {
      "$ref": "../../../_shared/base/common.schema.json#/definitions/audit_trail"
    }
  }
}
