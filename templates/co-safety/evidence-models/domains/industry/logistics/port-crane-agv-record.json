{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "port-crane-agv-record.json",
  "title": "Port Crane and AGV Safety Record",
  "description": "Evidence model for Port Gantry Crane Lifting and Automated Guided Vehicle Safety Records.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "record_id",
    "crane_agv_id",
    "collision_sensor_status",
    "legal_basis",
    "audit_trail"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^LGS-CRN-[0-9]{4}-[0-9]{4}$"
    },
    "crane_agv_id": {
      "type": "string"
    },
    "collision_sensor_status": {
      "type": "string",
      "enum": ["active_ok", "warning", "fault"]
    },
    "lifting_rig_inspected": {
      "type": "boolean"
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "audit_trail": {
      "$ref": "../../../_shared/base/common.schema.json#/definitions/audit_trail"
    }
  }
}
