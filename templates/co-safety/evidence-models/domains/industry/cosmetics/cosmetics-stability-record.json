{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cosmetics-stability-record.json",
  "title": "Cosmetics Stability Testing Record",
  "description": "Evidence model for Cosmetics Product Stability Testing and Expiry Evaluation Records.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "record_id",
    "batch_number",
    "stability_condition",
    "legal_basis",
    "audit_trail"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^COS-STB-[0-9]{4}-[0-9]{4}$"
    },
    "batch_number": {
      "type": "string"
    },
    "stability_condition": {
      "type": "string",
      "enum": ["accelerated_40c", "realtime_25c", "freeze_thaw"]
    },
    "test_result": {
      "type": "string",
      "enum": ["conforms", "non_conforms", "under_investigation"]
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "audit_trail": {
      "$ref": "../../../_shared/base/common.schema.json#/definitions/audit_trail"
    }
  }
}
