{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "food-allergen-record.json",
  "title": "Food Allergen Control Record",
  "description": "Evidence model for Food Allergen Cross-Contamination Prevention and Cleaning Verification Records.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "record_id",
    "line_id",
    "allergen_type",
    "legal_basis",
    "audit_trail"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^FOOD-ALG-[0-9]{4}-[0-9]{4}$"
    },
    "line_id": {
      "type": "string"
    },
    "allergen_type": {
      "type": "string"
    },
    "swab_test_result": {
      "type": "string",
      "enum": ["negative", "positive", "pending"]
    },
    "cleaning_verification_status": {
      "type": "string",
      "enum": ["passed", "failed", "recleaned"]
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "audit_trail": {
      "$ref": "../../../_shared/base/common.schema.json#/definitions/audit_trail"
    }
  }
}
