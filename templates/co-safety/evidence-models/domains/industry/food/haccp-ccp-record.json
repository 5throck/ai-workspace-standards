{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haccp-ccp-record.json",
  "title": "HACCP CCP Monitoring Record",
  "description": "Evidence model for HACCP Critical Control Point (CCP) Monitoring and Deviation Records.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "record_id",
    "ccp_number",
    "legal_basis",
    "audit_trail"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^FOOD-CCP-[0-9]{4}-[0-9]{4}$"
    },
    "ccp_number": {
      "type": "string"
    },
    "monitoring_parameter": {
      "type": "string"
    },
    "critical_limit": {
      "type": "string"
    },
    "observed_value": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["normal", "deviation", "corrected"]
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "audit_trail": {
      "$ref": "../../../_shared/base/common.schema.json#/definitions/audit_trail"
    }
  }
}
