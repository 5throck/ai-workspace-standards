{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lmo-biohazard-record.json",
  "title": "LMO Biohazard Containment Record",
  "description": "Evidence model for LMO Class 2-3 Biohazard Facility Negative Pressure and HEPA Filter Differential Integrity.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "record_id",
    "facility_bsl_level",
    "differential_pressure_pa",
    "legal_basis",
    "audit_trail"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^BIO-LMO-[0-9]{4}-[0-9]{4}$"
    },
    "facility_bsl_level": {
      "type": "string",
      "enum": ["BSL-1", "BSL-2", "BSL-3"]
    },
    "differential_pressure_pa": {
      "type": "number"
    },
    "hepa_filter_certified": {
      "type": "boolean"
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "audit_trail": {
      "$ref": "../../../_shared/base/common.schema.json#/definitions/audit_trail"
    }
  }
}
