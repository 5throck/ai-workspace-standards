{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bioreactor-sterilization-record.json",
  "title": "Bioreactor SIP Sterilization Safety Record",
  "description": "Evidence model for Commercial Bioreactor Steam-in-Place (SIP) Thermal and Pressure Relief Verification.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "record_id",
    "vessel_id",
    "sip_temperature_celsius",
    "legal_basis",
    "audit_trail"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^BIO-SIP-[0-9]{4}-[0-9]{4}$"
    },
    "vessel_id": {
      "type": "string"
    },
    "sip_temperature_celsius": {
      "type": "number"
    },
    "pressure_relief_tested": {
      "type": "boolean"
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "audit_trail": {
      "$ref": "../../../_shared/base/common.schema.json#/definitions/audit_trail"
    }
  }
}
