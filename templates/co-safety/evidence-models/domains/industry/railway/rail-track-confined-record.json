{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rail-track-confined-record.json",
  "title": "Rail Track Confined Maintenance Record",
  "description": "Evidence model for Night Track Maintenance Lookout Positioning and Tunnel Gas Safety.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "record_id",
    "tunnel_track_id",
    "lookout_person_assigned",
    "legal_basis",
    "audit_trail"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^RLW-TRK-[0-9]{4}-[0-9]{4}$"
    },
    "tunnel_track_id": {
      "type": "string"
    },
    "lookout_person_assigned": {
      "type": "boolean"
    },
    "train_interlock_active": {
      "type": "boolean"
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "audit_trail": {
      "$ref": "../../../_shared/base/common.schema.json#/definitions/audit_trail"
    }
  }
}
