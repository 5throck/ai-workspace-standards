{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "catenary-high-voltage-record.json",
  "title": "Railway Catenary High-Voltage Safety Record",
  "description": "Evidence model for 25kV Catenary Power Isolation and Portable Grounding Hook Verification.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "record_id",
    "track_section_id",
    "power_cut_verified",
    "legal_basis",
    "audit_trail"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^RLW-CAT-[0-9]{4}-[0-9]{4}$"
    },
    "track_section_id": {
      "type": "string"
    },
    "power_cut_verified": {
      "type": "boolean"
    },
    "grounding_hook_installed": {
      "type": "boolean"
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "audit_trail": {
      "$ref": "../../../_shared/base/common.schema.json#/definitions/audit_trail"
    }
  }
}
