# ============================================================
# AI Workspace Standards — .gitignore
# This repo tracks ONLY workspace-level config files.
# All project subdirectories are independent git repos.
# ============================================================

# --- Ignore all subdirectories (each is its own project, not tracked here) ---
# Workspace Root tracks ONLY: scripts/, templates/, agents/, docs/, skills/,
# memory/, and root-level config files. All other subdirectories are excluded.
/*/

# --- PM gateway approval flag (session-local, must not be committed) ---
.pm-approved

# --- Windows reserved device name artifacts (prevent accidental tracking) ---
nul
NUL

# --- Beta lifecycle raw tracking state (local operational data — must not be
# committed: holds per-engagement client identifiers and bug descriptions).
# Already caught by the /*/  rule above; documented explicitly here so this
# exclusion is never mistaken for an oversight (see tests/ un-ignore fix in
# 2026-07-11 history for why that distinction matters). The DURABLE aggregate
# (counts, eligibility, missing criteria — no per-engagement detail) is
# mirrored into the already-tracked templates/<variant>/variant.json under
# betaLifecycleSummary by scripts/helpers/beta-lifecycle.ts — see that file
# for the sync mechanism. ---
.pipeline-state/

# --- dev-sync pipeline temp files ---
CHANGELOG_ENTRY.md
.sync_context.tmp
.sync_context.*.tmp

# --- Secrets and local certs ---
.env
*.pem
*.key
*.cmd
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
*.cert
*.crt
credentials.json
*_credentials*
.env.*.local

# --- Node (workspace-level package.json artifacts) ---
node_modules/
# slash-less twin: the dir-only pattern above cannot match a node_modules SYMLINK
# (git classifies links by lstat, never follows) — a symlink got committed via
# this hole on 2026-10-08 (7b154db3, reverted cfa72c07). T-20261009-005.
node_modules
package-lock.json

# --- OS artifacts ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
# Generated IDE rule files (scripts/generate-ide-rules.ts) — regenerable, not committed
.cursorrules
.clauderules

# --- Python compiled ---
__pycache__/
*.pyc
*.pyo

# --- Claude local settings (personal, not shared) ---
.claude/settings.local.json
# --- Graft helper machine-local override (issue #1048: baked path stays untracked) ---
.claude/helpers/graft.local.json
# graft tool-owned mirrors + helpers (self-managed, design 2026-10-02-self-managed-tool-surfaces):
.claude/skills/graft/
.agents/skills/graft/
.codex/skills/graft/
.gemini/skills/graft/
.hermes/skills/graft/
.claude/helpers/graft-hooks.cjs
.claude/helpers/graft-statusline.cjs
# --- Claude Code worktrees (ephemeral, agent-created) ---
.claude/worktrees/
# --- Claude Code runtime artifacts (not shared) ---
.claude/launch.json
.claude/post-checkout.log

# --- Explicitly TRACK these workspace-level files ---
# (gitignore negations — override the /*/  rule above)
!CLAUDE.md
!GEMINI.md
!CONSTITUTION.md
!CHANGELOG.md
!README.md
!LICENSE
!.gitignore
!.githooks/
!.claude/
!.gemini/
!.agents/
!.codex/
!.hermes/
!scripts/
!templates/
!.editorconfig
!SECURITY.md
!AGENTS.md
!agents/
!memory/
!.github/
!docs/
!docs/constitution/
!docs/governance/
!docs/lifecycle/
!docs/designs/
!skills/
!templates/common/
!templates/co-consult/
!templates/co-price/
!templates/co-design/
!templates/co-develop/
!templates/co-learning/
!templates/co-game/
!templates/co-security/
!templates/co-work/
!tests/
!tickets/
!schemas/
# Team Gateway service (ADR-0092) — tracked; its runtime data dir is not.
!services/
services/co-workspace/data/
# Gateway tenant storage now lives at services/co-workspace/data/ (already ignored above).
# Runtime-image staging for the hermes bake (build-runtime-image.sh) is local-only.
services/co-workspace/docker/runtime-hermes/

nul
NUL

# --- Antigravity/ZCode session-local state (already caught by the /*/  rule
# above; documented explicitly per this file's own convention for local-only
# state directories, e.g. .pipeline-state/ above) ---
.zcode/
# ZCode harness regenerates this .gitignore mirror at the root each session;
# it is tool-local state like .zcode/ and never tracked (flagged by the
# lifecycle stray-file check on 2026-09-27, T-follow-up in memory log).
.zcodeignore

# --- Sandbox for testing ---
.sandbox/

# --- Ticket instances (tracked directory, ignored contents — Task 8) ---
tickets/*.yaml
# Shared ticket locks (T-20261002-005) — transient, never committed
tickets/.ticket-lock
tickets/governance/.ticket-lock
# Service ticket archive (spec 2026-10-04-ticket-archive-design) — service
# tickets are ephemeral, so their archive stays local-only like the live store;
# tickets/*.yaml above covers direct children only, not this subdirectory.
tickets/archive/
# Governance ticket archive (same spec) is deliberately git-tracked.

# Scaffolding test output (generated by scripts/test-new-project.ts)
test-project-*/

# External projects (not part of ai-workspace-standards)
co-deck2

# Archive directory ignored to save space (local preservation only)
memory/archive/

# Ignore test temp directories
tests/.temp/

# Scratch space for .claude/skills/simulate-project-creation (never tracked)
scripts/temp/

# Advisory concurrency lockfile for scripts/sync-skills.ts (T-20260912-017):
# PID + timestamp of the active run; session-local, never tracked.
.sync-skills.lock

# --- Claude Code plan-mode artifacts (session-local, must not be committed) ---
.claude/plans/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# assessment-service PDF font asset (downloaded, never committed)
services/assessment-service/assets/
