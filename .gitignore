# ============================================================
# AI Workspace Standards — .gitignore
# This repo tracks ONLY workspace-level config files.
# All project subdirectories are independent git repos.
# ============================================================

# --- Ignore all subdirectories (each is its own project, not tracked here) ---
# Workspace Root tracks ONLY: scripts/, templates/, agents/, docs/, skills/,
# memory/, and root-level config files. All other subdirectories are excluded.
/*/

# --- PM gateway approval flag (session-local, must not be committed) ---
.pm-approved

# --- Windows reserved device name artifacts (prevent accidental tracking) ---
nul
NUL

# --- GateGuard PID-keyed state persistence (session-local) ---
.gateguard-state/

# --- Beta lifecycle raw tracking state (local operational data — must not be
# committed: holds per-engagement client identifiers and bug descriptions).
# Already caught by the /*/  rule above; documented explicitly here so this
# exclusion is never mistaken for an oversight (see tests/ un-ignore fix in
# 2026-07-11 history for why that distinction matters). The DURABLE aggregate
# (counts, eligibility, missing criteria — no per-engagement detail) is
# mirrored into the already-tracked templates/<variant>/variant.json under
# betaLifecycleSummary by scripts/helpers/beta-lifecycle.ts — see that file
# for the sync mechanism. ---
.pipeline-state/

# --- dev-sync pipeline temp files ---
CHANGELOG_ENTRY.md
.sync_context.tmp
.sync_context.*.tmp

# --- Secrets and local certs ---
.env
*.pem
*.key
*.cmd
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
*.cert
*.crt
credentials.json
*_credentials*
.env.*.local

# --- Node (workspace-level package.json artifacts) ---
node_modules/
package-lock.json

# --- OS artifacts ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo

# --- Python compiled ---
__pycache__/
*.pyc
*.pyo

# --- Claude local settings (personal, not shared) ---
.claude/settings.local.json
# --- Claude Code worktrees (ephemeral, agent-created) ---
.claude/worktrees/
# --- Claude Code runtime artifacts (not shared) ---
.claude/launch.json
.claude/post-checkout.log

# --- Explicitly TRACK these workspace-level files ---
# (gitignore negations — override the /*/  rule above)
!CLAUDE.md
!GEMINI.md
!CONSTITUTION.md
!CHANGELOG.md
!README.md
!LICENSE
!.gitignore
!.githooks/
!.claude/
!.gemini/
!.agents/
!scripts/
!templates/
!.editorconfig
!SECURITY.md
!AGENTS.md
!agents/
!memory/
!.github/
!docs/
!docs/constitution/
!docs/governance/
!docs/lifecycle/
!docs/designs/
!skills/
!templates/common/
!templates/co-consult/
!templates/co-price/
!templates/co-design/
!templates/co-develop/
!templates/co-game/
!templates/co-security/
!templates/co-work/
!tests/
!tickets/
!schemas/

nul
NUL

# --- Antigravity/ZCode session-local state (already caught by the /*/  rule
# above; documented explicitly per this file's own convention for local-only
# state directories, e.g. .gateguard-state/ and .pipeline-state/ above) ---
.zcode/

# --- Sandbox for testing ---
.sandbox/

# --- Ticket instances (tracked directory, ignored contents — Task 8) ---
tickets/*.yaml

# Scaffolding test output (generated by scripts/test-new-project.ts)
test-project-*/

# External projects (not part of ai-workspace-standards)
co-deck2

# Archive directory ignored to save space (local preservation only)
memory/archive/

# Ignore test temp directories
tests/.temp/

# Scratch space for .claude/skills/simulate-project-creation (never tracked)
scripts/temp/

# --- Claude Code plan-mode artifacts (session-local, must not be committed) ---
.claude/plans/
