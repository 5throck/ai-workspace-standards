# .env.sample — copy to .env and fill in values
# Used by docker-compose.yml in this directory (compose reads `.env` from here).
# All variables are optional unless marked REQUIRED — unset variables fall back to
# the compose defaults shown commented out. NEVER commit the real .env.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Absolute host path of the gateway data dir (registry/turns/audit DBs + storage/).
# Bind-mounted at /data AND used as the sibling-container mount source for docker
# isolation. Use a durable path — /tmp clones vanish on reboot.
CO_WORKSPACE_DATA_DIR_HOST=/absolute/host/path/to/services/co-workspace/data

# Hermes home with credentials (e.g. ~/.hermes). Mounted read-only at /seed-home
# (directory bind) and copied into team homes: .env at provisioning, auth.json
# per-turn in legacy (no provider key) mode.
CO_WORKSPACE_HERMES_SEED_HOME=/absolute/host/path/to/.hermes

# ── LLM provider (recommended — provider key+base-url mode) ──────────────────
# Static provider credentials instead of the OAuth auth.json flow. The selector
# mirrors the co-newbiz scheme and picks which env var carries the key inside
# the turn: openai/custom → OPENAI_API_KEY, anthropic → ANTHROPIC_API_KEY,
# gemini → GOOGLE_API_KEY, zai → ZAI_API_KEY (hermes's zai provider preserves
# dotted model ids on Z.AI's anthropic-compatible endpoint). `none` = off.
#   BASE_URL is required for custom, optional override for named providers
#   (zai pairs with https://api.z.ai/api/anthropic — the coding-plan endpoint).
#   MODEL is stamped into team config.yaml (model.default).
#CO_WORKSPACE_LLM_PROVIDER=custom
#CO_WORKSPACE_LLM_BASE_URL=https://api.openai.com/v1
#CO_WORKSPACE_LLM_API_KEY=your_provider_api_key_here
#CO_WORKSPACE_HERMES_MODEL=upstage/solar-pro4:free

# ── Teams / catalog ──────────────────────────────────────────────────────────
#CO_WORKSPACE_VARIANTS=all                          # "all" auto-discovers templates/co-*
#CO_WORKSPACE_VARIANTS_INCLUDE_BETA=true
#CO_WORKSPACE_TEMPLATE_VERSION=                     # pin a template tag (default: templates/VERSION)

# ── Turn budgets & toolsets ──────────────────────────────────────────────────
#CO_WORKSPACE_RUN_BUDGET_SECONDS=300
#CO_WORKSPACE_MAX_TURNS=100
#CO_WORKSPACE_HERMES_TOOLSETS=                      # e.g. fs,web (first-class scoping)
#CO_WORKSPACE_HERMES_EXTRA_ARGS=
#HERMES_BIN=hermes

# ── Quotas (Phase 2, enforced before any stream opens) ───────────────────────
#CO_WORKSPACE_QUOTA_WINDOW=lifetime                 # lifetime | daily
#CO_WORKSPACE_TENANT_MAX_TURNS=0                    # 0 = unlimited
#CO_WORKSPACE_TENANT_MAX_TOKENS=0                   # 0 = unlimited
#CO_WORKSPACE_TENANT_MAX_PER_PRINCIPAL=10

# ── Auth & web ───────────────────────────────────────────────────────────────
#CO_WORKSPACE_LOGIN_REQUIRED=true                   # web UI session gate
#CO_WORKSPACE_CSRF_REQUIRED=true                    # keyless mutating routes need x-requested-with
#CO_WORKSPACE_API_KEYS=                             # Bearer keys, comma-separated; empty = keyless mode
#CO_WORKSPACE_API_KEYS_FILE_HOST=                   # file-based keys (default: <seed home>/.env.keys)
#CO_WORKSPACE_ADMIN_EMAIL=                          # bootstrap admin on first start
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_REDIRECT_URI=

# ── Runtime & isolation ──────────────────────────────────────────────────────
#CO_WORKSPACE_RUNTIME=hermes                        # hermes | antigravity | claude | codex
#CO_WORKSPACE_ISOLATION=process                     # process | docker (docker needs the runtime
#                                                  #  image + /var/run/docker.sock, both wired in compose)
#CO_WORKSPACE_RUNTIME_IMAGE=co-workspace-runtime:latest
#CO_WORKSPACE_CONTAINER_MEMORY=2g
#CO_WORKSPACE_CONTAINER_CPUS=2
#CO_WORKSPACE_CONTAINER_PIDS_LIMIT=256
# Workspace clone used for scaffolding. Default: the repo checkout three levels up.
# For durable deployments set a dedicated clone (e.g. /srv/co-workspace-workspace).
#CO_WORKSPACE_WORKSPACE_DIR_HOST=../../../
#CO_WORKSPACE_HERMES_AUTH_DIR_HOST=                 # host path of the shared token store (default: <seed home>/shared)
#CO_WORKSPACE_HERMES_AUTH_DIR=/seed/shared          # in-container path of the shared store
#HERMES_INFERENCE_PROVIDER=
#HERMES_INFERENCE_MODEL=
